# Zkopírujte jako .env a upravte. Žádné skutečné tajné hodnoty do gitu.

# --- Aplikace ---
# Veřejná adresa webu (bez lomítka na konci), používá se v e-mailech a pro návrat z platební brány.
APP_URL=http://localhost:3000
# Hlavní doména. Ostatní domény (např. belehrad1976.cz) se na ni přesměrují. Prázdné = bez přesměrování.
PRIMARY_HOST=

# --- Databáze (PostgreSQL) ---
DATABASE_URL=postgresql://eshop@localhost:5544/eshop

# --- GoPay ---
# mock = testovací simulace brány bez GoPay účtu (jen pro vývoj), sandbox = testovací GoPay, production = ostrá brána
GOPAY_MODE=mock
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
# Povolené platební metody v GoPay (oddělené čárkou)
GOPAY_INSTRUMENTS=PAYMENT_CARD,BANK_ACCOUNT,APPLE_PAY,GPAY

# --- E-maily (SMTP) ---
# Bez SMTP_HOST se e-maily neodesílají, ale ukládají do složky .mail-outbox (vývoj).
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=resend, SMTP_PASSWORD=<API klíč re_…>
# Doména belehrad76.cz musí být v Resendu ověřená (DNS záznamy DKIM, SPF, MX pro send.belehrad76.cz).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Mistři Evropy 1976 <info@belehrad76.cz>"

# --- Zásilkovna (výběr výdejního místa / Z-BOXu u kusovek) ---
# API klíč z klientské sekce Zásilkovny. Bez klíče se při vývoji nabízí testovací výdejní místo.
PACKETA_API_KEY=
# API heslo (tajné) – zakládání zásilek a tisk štítků z administrace. Bez něj se zásilky zadávají ručně v klientské sekci.
PACKETA_API_PASSWORD=

# --- Naplánované úlohy ---
# Tajný klíč pro /api/cron/expire (rušení nezaplacených objednávek po vypršení rezervace)
CRON_SECRET=change-me

# --- Ochrana proti botům (Cloudflare Turnstile, volitelné) ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Měření (volitelné, načítá se až po souhlasu s cookies) ---
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
# Meta Conversions API (server-side událost Purchase)
META_CAPI_TOKEN=

# --- Vývojová verze (např. Vercel): celý web za HTTP heslem "jmeno:heslo". Na ostré verzi nenastavovat. ---
DEV_BASIC_AUTH=
# Vývojová verze bez hesla: true = zakázat indexování vyhledávači (robots.txt + X-Robots-Tag). Na ostré verzi nenastavovat.
DEV_NOINDEX=
